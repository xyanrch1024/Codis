---
import Base from "../layouts/Base.astro";

const releases = "https://github.com/xyanrch1024/Codis/releases/latest/download";
const repo = "https://github.com/xyanrch1024/Codis";

const features = [
  {
    title: "多 Provider",
    desc: "OpenAI / DeepSeek / GLM / Groq，配置文件驱动，运行时可随时切换。",
  },
  {
    title: "全双工 WebSocket",
    desc: "一条连接既发请求又收流式推送，模型输出按 token 实时到达，含思维链。",
  },
  {
    title: "工具调用",
    desc: "bash / read / write / edit / glob / grep，支持 C ABI 插件动态扩展。",
  },
  {
    title: "多客户端共享会话",
    desc: "CLI / TUI / 飞书机器人共用同一 session，互不干扰。",
  },
  {
    title: "会话持久化",
    desc: "SQLite 存储，支持恢复历史、切换、删除、搜索；消息排队补跑不丢失。",
  },
  {
    title: "终端 TUI",
    desc: "FTXUI 界面：颜色区分消息、滚轮滚动、双击 ESC 取消任务、断线自动重连补发。",
  },
  {
    title: "Docker 一键部署",
    desc: "单容器运行，开箱即用。",
  },
  {
    title: "纯 C++20",
    desc: "CMake + vcpkg 构建，无运行时依赖，开源自托管。",
  },
];

const downloads = [
  { os: "Linux", arch: "x86_64", url: `${releases}/codis-linux-x64.tar.gz` },
  { os: "macOS", arch: "Apple Silicon", url: `${releases}/codis-macos-arm64.tar.gz` },
  { os: "Windows", arch: "x86_64", url: `${releases}/codis-windows-x64.zip` },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="badge mono">C++20 · MIT · FTXUI TUI</span>
      <h1>一套服务端，<span class="term">多种客户端</span></h1>
      <p class="sub">
        Codis 是一个基于 C++20 的 AI 编程助手——多 Provider、全双工 WebSocket
        流式输出、工具调用、SQLite 会话持久化，以及一个用 FTXUI 构建的终端 TUI。
      </p>
      <div class="install-cmd mono">
        <span class="cmd"><span style="color:var(--accent)">$</span> curl -fsSL https://codis.chat/install | bash</span>
        <button class="copy" id="copy-install" type="button">Copy</button>
      </div>
      <script is:inline>
        const btn = document.getElementById("copy-install");
        btn?.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(
              "curl -fsSL https://codis.chat/install | bash"
            );
            btn.textContent = "已复制";
            btn.classList.add("copied");
            setTimeout(() => {
              btn.textContent = "Copy";
              btn.classList.remove("copied");
            }, 1500);
          } catch {
            /* 剪贴板不可用时忽略 */
          }
        });
      </script>
      <div class="cta">
        <a class="btn btn-primary" href="#download">下载 Codis</a>
        <a class="btn" href="#quickstart">快速开始</a>
        <a class="btn" href={repo} target="_blank" rel="noopener">GitHub ↗</a>
      </div>

      <div class="terminal mono">
        <div class="bar">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="term-title">codis — 终端 AI 助手</span>
        </div>
        <pre><span class="c">$</span> codis -c
<span class="c">▌ User</span> 帮我查一下项目里的 TODO
<span class="c">▌ Codis</span> 让我先搜索一下。
<span class="c">▾ bash</span> grep -rn "TODO" --include="*.cpp" .
<span class="b">│ libs/server/src/server.cpp:42:  // TODO: retry on 429</span>
<span class="b">│ libs/cli/src/tui.cpp:110:  // TODO: fold long outputs</span>
<span class="c">▾ grep</span> TODO --include="*.cpp"
<span class="b">│ 2 results in 0.02s</span>
<span class="c">▌ Codis</span> 共找到 2 处 TODO（详见上面工具输出），需要我一并处理吗？</pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features">
    <div class="container">
      <h2>特性</h2>
      <p class="lead">为终端而生的 AI 编程助手</p>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <h3><code>{f.title}</code></h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Download -->
  <section id="download">
    <div class="container">
      <h2>下载</h2>
      <p class="lead">预编译二进制，解压即用（GitHub Releases）</p>
      <div class="downloads">
        {downloads.map((d) => (
          <div class="dl">
            <div class="os">{d.os} <span>{d.arch}</span></div>
            <a class="btn" href={d.url}>下载 {d.os}</a>
          </div>
        ))}
        <div class="dl">
          <div class="os">源码 <span>GitHub</span></div>
          <a class="btn" href={repo} target="_blank" rel="noopener">Clone ↗</a>
        </div>
      </div>
      <p class="lead" style="margin-top:28px">或从源码构建</p>
      <div class="build-steps">
        <pre class="code mono"><span class="c"># 依赖：CMake 3.20+ / vcpkg / C++20 编译器</span>
git clone https://github.com/xyanrch1024/Codis.git
<span class="c"># vcpkg install cpp-httplib nlohmann-json cli11 tomlplusplus openssl sqlite3 ftxui asio</span>
cmake -B build -S . -DCMAKE_TOOLCHAIN_FILE=$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake
cmake --build build -j$(nproc)</pre>
      </div>
    </div>
  </section>

  <!-- Quickstart -->
  <section id="quickstart">
    <div class="container">
      <h2>快速开始</h2>
      <p class="lead">设置 API Key，一条命令启动（CLI 会自动拉起服务端）</p>
      <pre class="code mono"><span class="c">$</span> export GLM_API_KEY="your-api-key"
<span class="c">$</span> codis
<span class="c">$</span> codis -c          <span class="d"># 继续上次会话</span>
<span class="c">$</span> codis -p 8711 -m glm-4.5-flash   <span class="d"># 指定端口 / 模型</span></pre>
      <p class="lead" style="margin-top:28px">Docker 部署</p>
      <pre class="code mono"><span class="c">$</span> docker run -d --name codis \
  -e GLM_API_KEY="xxx" \
  -p 8711:8711 \
  ghcr.io/xyanrch1024/codis:latest</pre>
      <p class="lead" style="margin-top:28px">
        TUI 快捷键：<code>↑↓</code> / 滚轮滚动 · <code>ESC ESC</code> 取消任务 ·
        <code>Ctrl+S</code> 会话列表 · <code>Ctrl+C</code> 退出
      </p>
    </div>
  </section>
</Base>